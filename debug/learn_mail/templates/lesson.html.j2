{#- One template, two outputs. mode="web" embeds interactive charts; mode="email"
    embeds the same charts as inline PNGs. All styling is inline so email clients
    that drop <style> blocks still show the same page. -#}
{%- set P = 'style="margin:0 0 12px;font-size:16px;line-height:1.75;color:#1d1f23"' -%}
{%- set STEP = 'style="margin:28px 0 4px;font-size:13px;letter-spacing:.06em;color:#898781"' -%}
{%- set H2 = 'style="margin:0 0 10px;font-size:19px;line-height:1.45;color:#0b0b0b"' -%}
{%- set CAP = 'style="margin:6px 0 12px;font-size:13px;line-height:1.6;color:#4d5158"' -%}
{%- set TH = 'style="text-align:right;padding:6px 8px;border-bottom:1px solid #d9dce2;font-size:13px;color:#4d5158;white-space:nowrap"' -%}
{%- set TD = 'style="text-align:right;padding:6px 8px;border-bottom:1px solid #d9dce2;font-size:14px;white-space:nowrap"' -%}
{%- set TL = 'style="text-align:left;padding:6px 8px;border-bottom:1px solid #d9dce2;font-size:14px;white-space:nowrap"' -%}
{%- set TDB = 'style="text-align:right;padding:6px 8px;border-bottom:1px solid #d9dce2;font-size:14px;white-space:nowrap;font-weight:700"' -%}
{%- set TLB = 'style="text-align:left;padding:6px 8px;border-bottom:1px solid #d9dce2;font-size:14px;white-space:nowrap;font-weight:700"' -%}
{%- set THL = 'style="text-align:left;padding:6px 8px;border-bottom:1px solid #d9dce2;font-size:13px;color:#4d5158;white-space:nowrap"' -%}
{%- macro chart(id, alt_text) -%}
{%- if mode == "web" -%}
<div id="vis-{{ id }}" style="width:100%;min-height:200px"></div>
<noscript><img src="{{ id }}.png" alt="{{ alt_text }}" style="width:100%;height:auto"></noscript>
{%- else -%}
<img src="cid:{{ cids[id] }}" alt="{{ alt_text }}" width="560" style="display:block;width:100%;max-width:560px;height:auto;border:1px solid #d9dce2;border-radius:6px">
{%- endif -%}
{%- endmacro -%}
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ L.title }}</title>
</head>
<body style="margin:0;background:#f7f8fa;font-family:'PingFang SC','Hiragino Sans','Noto Sans SC','Microsoft YaHei',sans-serif;color:#1d1f23">
<div style="max-width:680px;margin:0 auto;padding:24px 16px 48px">
{%- if mode == "web" %}
<p style="margin:0 0 16px;font-size:13px"><a href="../../" style="color:#2a78d6">全部课程</a></p>
{%- endif %}
<h1 style="margin:0 0 8px;font-size:25px;line-height:1.35;color:#0b0b0b">{{ L.title }}</h1>
<p style="margin:0;font-size:14px;color:#4d5158">{{ L.subtitle }}</p>

<p {{ STEP }}>第 1 步 · 这是哪家公司</p>
<h2 {{ H2 }}>{{ L.who_heading }}</h2>
<p {{ P }}>{{ L.who_body }}</p>

<p {{ STEP }}>第 2 步 · 发生了什么</p>
<h2 {{ H2 }}>{{ L.what_heading }}</h2>
<p {{ P }}>{{ L.what_body }}</p>
<table role="presentation" style="width:100%;border-collapse:separate;border-spacing:0 8px"><tr>
{%- for value, label in L.stats %}
<td style="background:#fcfcfb;border:1px solid #d9dce2;border-radius:6px;padding:10px 12px;vertical-align:top;width:33%">
<div style="font-size:20px;font-weight:700;line-height:1.3">{{ value }}</div>
<div style="font-size:13px;color:#4d5158">{{ label }}</div></td>{% if not loop.last %}<td style="width:8px"></td>{% endif %}
{%- endfor %}
</tr></table>

<div style="margin:24px 0 8px;background:#eef3fb;border-radius:6px;padding:14px 16px">
<p style="margin:0 0 4px;font-size:13px;letter-spacing:.06em;color:#4d5158">先猜一猜</p>
<p style="margin:0 0 6px;font-size:18px;font-weight:700;line-height:1.5">{{ L.guess_question }}</p>
<p style="margin:0;font-size:15px;line-height:1.7">{{ L.guess_body }}</p>
</div>
<p style="margin:20px 0 0;text-align:center;font-size:13px;color:#898781;border-top:1px dashed #c3c2b7;padding-top:8px">答案在下面</p>

<p {{ STEP }}>第 3 步 · 股价怎么反应</p>
<h2 {{ H2 }}>{{ L.reaction_heading }}</h2>
{{ chart("reaction", "财报前后股价与大盘的涨跌幅对比") }}
<p {{ CAP }}>{{ L.reaction_caption }}</p>
<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums">
<tr><th {{ THL }}>财报之后</th><th {{ TH }}>{{ L.name }}</th><th {{ TH }}>大盘</th><th {{ TH }}>{{ L.name }}比大盘</th></tr>
{%- for label, s, b, diff in L.after_rows %}
<tr><td {{ TL }}>{{ label }}</td><td {{ TD }}>{{ s }}</td><td {{ TD }}>{{ b }}</td><td {{ TD }}>{{ diff }}</td></tr>
{%- endfor %}
</table></div>
<p style="margin:14px 0 12px;font-size:16px;line-height:1.75;color:#1d1f23">{{ L.money }}</p>
<p {{ P }}><b>为什么要和大盘比?</b>{{ L.why_market }}</p>

<p {{ STEP }}>第 4 步 · 以前也这样吗</p>
<h2 {{ H2 }}>{{ L.history_heading }}</h2>
{{ chart("history", "最近几次财报公布后第二天的股价涨跌") }}
<p {{ CAP }}>{{ L.history_caption }}</p>
<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums">
<tr><th {{ THL }}>公布日</th><th {{ TH }}>预期</th><th {{ TH }}>实际</th><th {{ TH }}>高出</th><th {{ TH }}>第二天</th><th {{ TH }}>20 日后</th></tr>
{%- for r in L.history_rows %}
{%- set td = TDB if r.now else TD %}{%- set tl = TLB if r.now else TL %}
<tr><td {{ tl }}>{{ r.announce }}</td><td {{ td }}>{{ r.est }}</td><td {{ td }}>{{ r.act }}</td><td {{ td }}>{{ r.surprise }}</td><td {{ td }}>{{ r.d1 }}</td><td {{ td }}>{{ r.d20 }}</td></tr>
{%- endfor %}
</table></div>

<p {{ STEP }}>第 5 步 · 能学到什么</p>
<h2 {{ H2 }}>{{ L.learn_heading }}</h2>
<ol style="margin:0 0 12px;padding-left:1.3em">
{%- for bold, text in L.learn_items %}
<li style="margin:0 0 10px;font-size:16px;line-height:1.75"><b>{{ bold }}</b>{{ text }}</li>
{%- endfor %}
</ol>
<p style="margin:0;background:#eef3fb;border-radius:6px;padding:12px 14px;font-size:15px;line-height:1.7"><b>这份材料回答不了的问题:</b>{{ L.open_question }}</p>

<p {{ STEP }}>这一课用到的词</p>
{%- for term, text in L.glossary %}
<p style="margin:0 0 8px;font-size:15px;line-height:1.7"><b>{{ term }}</b>&nbsp;&nbsp;<span style="color:#4d5158">{{ text }}</span></p>
{%- endfor %}

{%- if mode == "email" %}
<p style="margin:28px 0 0;font-size:15px;line-height:1.7">在网页上看这一课,图可以点按看每天的数字:<br><a href="{{ page_url }}" style="color:#2a78d6">{{ page_url }}</a></p>
<p style="margin:6px 0 0;font-size:13px;color:#4d5158">网页需要手机上的 Tailscale 开着才能打开。</p>
{%- endif %}
<p style="margin:28px 0 0;padding-top:12px;border-top:1px solid #d9dce2;font-size:13px;color:#898781">{{ L.footer }}</p>
</div>
{%- if mode == "web" %}
<script src="https://cdn.jsdelivr.net/npm/vega@{{ versions.vega }}"></script>
<script src="https://cdn.jsdelivr.net/npm/vega-lite@{{ versions.vegalite }}"></script>
<script src="https://cdn.jsdelivr.net/npm/vega-embed@{{ versions.embed }}"></script>
<script>
const specs = {{ specs | tojson }};
for (const [id, spec] of Object.entries(specs)) {
  vegaEmbed("#vis-" + id, spec, {actions: false, renderer: "svg"}).catch(err => {
    document.getElementById("vis-" + id).innerHTML = '<img src="' + id + '.png" alt="" style="width:100%;height:auto">';
    console.error(err);
  });
}
</script>
{%- endif %}
</body>
</html>
